# ============================================================================
#  VARIABLES D'ENVIRONNEMENT — SITE MEMORART (Vercel)
# ============================================================================
#  Seules les variables NEXT_PUBLIC_* sont utilisées par le site (frontend).
#  Les autres (n8n, Apiframe, etc.) NE vont PAS ici : elles vivent dans n8n.
#  Copie ce fichier en .env.local pour le développement, et renseigne les
#  mêmes valeurs dans l'onglet Environment Variables de Vercel en production.
# ============================================================================

# --- OBLIGATOIRE : branchement Chariow ---
# URL de checkout de ton produit Chariow (à remplacer par la vraie).
NEXT_PUBLIC_CHARIOW_CHECKOUT_URL="https://VOTRE-BOUTIQUE.chariow.store/checkout/VOTRE-PRODUIT"
# Nom du paramètre de champ personnalisé attendu par Chariow (souvent custom_field ou cf).
NEXT_PUBLIC_CHARIOW_CUSTOM_FIELD="custom_field"

# --- OPTIONNEL : bouton support ---
# Numéro WhatsApp au format international sans + (ex: 22890000000). Laisser vide pour masquer.
NEXT_PUBLIC_SUPPORT_WHATSAPP=""
